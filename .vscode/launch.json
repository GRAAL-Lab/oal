{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug OAL Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/oal_test",  // Ensure path to the test binary
            "args": [],                                         // Add test arguments if needed
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",                                   // Use "lldb" for macOS
            "miDebuggerPath": "/usr/bin/gdb",                  // Path to GDB
            "logging": {
                "engineLogging": false,
                "traceResponse": false
            },
            "targetArchitecture": "x64"
        }
    ]
}
